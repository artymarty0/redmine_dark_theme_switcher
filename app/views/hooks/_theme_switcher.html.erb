<div id="theme-icons-template" style="display: none;">
  <span class="icon-light" title="<%= l(:label_toggle_theme) %>">
    <svg xmlns="http://w3.org" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
      <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
    </svg>
  </span>
  <span class="icon-dark" title="<%= l(:label_toggle_theme) %>">
    <svg xmlns="http://w3.org" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
    </svg>
  </span>
  <span class="theme-text"><%= l(:label_theme) %></span>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const btn = document.getElementById('theme-toggle-btn');
    const template = document.getElementById('theme-icons-template');
    if (!btn || !template) return;

    btn.innerHTML = template.innerHTML;
    btn.setAttribute('title', '<%= j l(:label_toggle_theme) %>');
    template.remove();

    const sunIcon = btn.querySelector('.icon-light');
    const moonIcon = btn.querySelector('.icon-dark');

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark-mode');
      sunIcon.style.display = isDark ? 'inline-flex' : 'none';
      moonIcon.style.display = isDark ? 'none' : 'inline-flex';
    }

    updateIcons();

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const isDark = document.documentElement.classList.toggle('dark-mode');
      localStorage.setItem('redmine-theme', isDark ? 'dark' : 'light');
      updateIcons();
    });
  });
</script>
